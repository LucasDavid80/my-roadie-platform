{
  "name": "frontend-web",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:unit": "vitest run unit",
    "test:integration": "vitest run integration",
    "test:ui": "vitest run ui",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "coverage": "vitest run --coverage",
    "coverage:unit": "vitest run unit --coverage --coverage.reportsDirectory=coverage/unit",
    "coverage:integration": "vitest run integration --coverage --coverage.reportsDirectory=coverage/integration",
    "coverage:ui": "vitest run ui --coverage --coverage.reportsDirectory=coverage/ui",
    "coverage:e2e": "cross-env E2E_COVERAGE=1 playwright test",
    "coverage:all": "npm run coverage && npm run coverage:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.105.3",
    "axios": "^1.15.2",
    "lucide-react": "^1.9.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.73.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.0",
    "monocart-reporter": "^2.15.1",
    "msw": "^2.13.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
